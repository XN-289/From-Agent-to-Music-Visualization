# LLM 模式一：直连 DeepSeek（pi 内置模型目录：deepseek-v4-flash / deepseek-v4-pro）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# LLM 模式二：中转站 / 任意 OpenAI 兼容端点（设置 LLM_BASE_URL 即启用，优先于直连）
LLM_BASE_URL=
LLM_API_KEY=

# Suno Provider：musicproxy（公司统一网关，默认）| mock（本地合成演示）| sunoapi（sunoapi.org 第三方 API）
SUNO_PROVIDER=musicproxy
SUNO_API_KEY=
SUNO_API_BASE=

# 公司统一音乐代理（music-proxy-service）
MUSIC_PROXY_BASE_URL=http://127.0.0.1:8800
MUSIC_PROXY_API_KEY=
MUSIC_PROXY_DEFAULT_PROVIDER=suno_openaihk
MUSIC_PROXY_MODEL=auto

# Folia Stage 一键导入
FOLIA_STAGE_BASE_URL=http://127.0.0.1:32107
FOLIA_STAGE_TOKEN=
FOLIA_WEB_URL=http://127.0.0.1:3001

# 本地 SQLite 路径
DB_PATH=./data/music-agent.db

# 本地 Mock 音频 URL 的下载来源；通常与 pnpm dev 的实际地址保持一致
MUSIC_AGENT_ORIGIN=http://127.0.0.1:3000
